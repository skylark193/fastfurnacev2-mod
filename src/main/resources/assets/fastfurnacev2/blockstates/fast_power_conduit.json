{
  "multipart": [
    {"apply": {"model": "fastfurnacev2:block/fast_power_conduit_core"}},
    {"when": {"north": true}, "apply": {"model": "fastfurnacev2:block/fast_power_conduit_arm", "uvlock": true}},
    {"when": {"east": true}, "apply": {"model": "fastfurnacev2:block/fast_power_conduit_arm", "y": 90, "uvlock": true}},
    {"when": {"south": true}, "apply": {"model": "fastfurnacev2:block/fast_power_conduit_arm", "y": 180, "uvlock": true}},
    {"when": {"west": true}, "apply": {"model": "fastfurnacev2:block/fast_power_conduit_arm", "y": 270, "uvlock": true}},
    {"when": {"up": true}, "apply": {"model": "fastfurnacev2:block/fast_power_conduit_arm", "x": 270, "uvlock": true}},
    {"when": {"down": true}, "apply": {"model": "fastfurnacev2:block/fast_power_conduit_arm", "x": 90, "uvlock": true}}
  ]
}
